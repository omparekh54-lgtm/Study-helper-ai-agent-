# Copy to .env for local development. Never commit real keys.

# Postgres URL (Neon / Supabase / Render). Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# "live" = Gemini + Groq, "fake" = offline deterministic generator (no keys needed)
LLM_MODE=live
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: embeds real YouTube videos per topic (otherwise search links are shown)
YOUTUBE_API_KEY=

# Browser origins allowed to call the API (comma-separated). *.vercel.app previews are allowed by default.
FRONTEND_ORIGINS=http://localhost:3000

# Voice for narrated videos (any edge-tts voice, e.g. en-IN-NeerjaNeural, en-GB-SoniaNeural)
TTS_VOICE=en-US-AndrewNeural
